{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "employeetrack",
  "version": "1.6.0",
  "identifier": "com.briannguyen.bibotracking",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BiBoTracking",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/screenshots/**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bibo"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCN0U5RDExNkJGNERERTgKUldUbzNmUnJFWjErcStXZlBqMnJoVWtZbW5ScmppNUc2bXRXMUJuYW5US2JmVmVPSXN5M1NsRXcK",
      "endpoints": ["https://bibotracker.com/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Nguyen Giang Nam (MVT95X368D)"
    }
  }
}
